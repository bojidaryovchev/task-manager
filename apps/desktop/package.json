{
  "name": "@task-manager/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Task Manager desktop application",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-builder --win --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@task-manager/shared": "workspace:*",
    "@task-manager/telemetry-native": "workspace:*",
    "@task-manager/telemetry-types": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}