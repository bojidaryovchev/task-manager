{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@task-manager/telemetry-types": [
        "../../packages/telemetry-types/src/index.ts"
      ],
      "@task-manager/shared": [
        "../../packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/shared/**/*.ts",
    "src/preload/**/*.d.ts",
    "../../packages/telemetry-types/src/**/*.ts",
    "../../packages/shared/src/**/*.ts"
  ]
}
