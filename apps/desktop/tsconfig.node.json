{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@task-manager/telemetry-types": [
        "../../packages/telemetry-types/src/index.ts"
      ],
      "@task-manager/shared": [
        "../../packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "electron.vite.config.ts",
    "../../packages/telemetry-types/src/**/*.ts",
    "../../packages/shared/src/**/*.ts"
  ]
}
