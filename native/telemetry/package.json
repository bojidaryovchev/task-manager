{
  "name": "@task-manager/telemetry-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "telemetry",
    "targets": ["x86_64-pc-windows-msvc"]
  },
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "scripts": {
    "build": "napi build --platform --release --js index.js --dts index.d.ts",
    "build:debug": "napi build --platform --js index.js --dts index.d.ts",
    "test": "cargo test --manifest-path Cargo.toml",
    "clippy": "cargo clippy --all-targets -- -D warnings",
    "fmt": "cargo fmt"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6"
  }
}
